<Window x:Class="PlaceRadiators.PlaceRadiatorsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расставить радиаторы"
        Height="740" Width="460" MinHeight="740" MinWidth="460" MaxHeight="740" MaxWidth="460"
        Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Language="ru-RU"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="{DynamicResource BaseFont}"
        FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBgBrush}"
        KeyDown="FillMEPParametersWPF_KeyDown">

    <!-- Тема Citrus -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Enter / Esc (если не обрабатываешь в KeyDown) -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{x:Static ApplicationCommands.NotACommand}"/>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.NotACommand}"/>
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- скроллируемый контент -->
            <RowDefinition Height="Auto"/>
            <!-- нижняя панель -->
        </Grid.RowDefinitions>

        <!-- ===== Контент ===== -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ГРУППА 1: Параметр ширины окна -->
                <GroupBox Grid.Row="0" Header="Параметр ширины окна" Padding="10" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Параметр ширины" Margin="0,0,0,4"/>
                        <ComboBox x:Name="comboBox_WindowWidthParameter"
                                  Height="32"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <Separator Grid.Row="1" Opacity="0"/>

                <!-- ГРУППА 2: Семейство и тип радиатора -->
                <GroupBox Grid.Row="2" Header="Выбор семейства и типа радиатора" Padding="10" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Исходное семейство" Margin="0,0,0,4"/>
                        <ComboBox x:Name="comboBox_RadiatorFamilySelection"
                                  Height="32"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="comboBox_RadiatorFamilySelection_SelectionChanged"/>

                        <TextBlock Text="Исходный тип" Margin="0,8,0,4"/>
                        <ComboBox x:Name="comboBox_RadiatorTypeSelection"
                                  Height="32"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="comboBox_RadiatorTypeSelection_SelectionChanged"/>

                        <GroupBox x:Name="groupBox_RadiatorWidthBy"
                                  Header="Параметр длины по:"
                                  Padding="8"
                                  Margin="0,10,0,0">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="radioButton_Instance"
                                             Content="Экземпляр"
                                             IsChecked="True"
                                             HorizontalAlignment="Center"
                                             Checked="radioButton_RadiatorWidthBy_Checked"/>
                                <RadioButton x:Name="radioButton_Type"
                                             Content="Тип"
                                             HorizontalAlignment="Center"
                                             Checked="radioButton_RadiatorWidthBy_Checked"/>
                            </UniformGrid>
                        </GroupBox>

                        <TextBlock Text="Параметр длины радиатора" Margin="0,10,0,4"/>
                        <ComboBox x:Name="comboBox_RadiatorWidthParameter"
                                  Height="32"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"/>

                        <TextBlock x:Name="label_RadiatorThicknessParameter"
                                   Text="Параметр толщины радиатора"
                                   Margin="0,10,0,4"/>
                        <ComboBox x:Name="comboBox_RadiatorThicknessParameter"
                                  Height="32"
                                  MinHeight="32"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <Separator Grid.Row="3" Opacity="0"/>

                <!-- ГРУППА 3: Параметры размещения -->
                <GroupBox Grid.Row="4" Header="Параметры размещения" Padding="10" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <!-- % длины от ширины окна -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Процент длины радиатора от ширины окна"
                                   VerticalAlignment="Center" Height="32"/>
                        <TextBox x:Name="textBox_PercentageLength"
                                 Grid.Row="0" Grid.Column="1"
                                 Height="32" Text="50"
                                 MinHeight="32"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="%" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32"/>

                        <!-- Отступ от уровня -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Отступ от уровня"
                                   VerticalAlignment="Center" Height="32"/>
                        <TextBox x:Name="textBox_IndentFromLevel"
                                 Grid.Row="2" Grid.Column="1"
                                 Height="32" Text="100"
                                 MinHeight="32"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="мм" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32"/>

                        <!-- Отступ от стены -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Отступ от стены"
                                   VerticalAlignment="Center" Height="32"/>
                        <TextBox x:Name="textBox_IndentFromWall"
                                 Grid.Row="4" Grid.Column="1"
                                 Height="32" Text="100"
                                 MinHeight="32"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="2"
                                   Text="мм" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- ===== Нижняя панель кнопок ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource PageBgBrush}"
                Padding="0" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button x:Name="btn_Ok"
                            Content="OK"
                            Width="110" Height="32"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="btn_Ok_Click"/>
                    <Button x:Name="btn_Cancel"
                            Content="Отмена"
                            Width="110" Height="32"
                            IsCancel="True"
                            Click="btn_Cancel_Click"
                            Style="{StaticResource ButtonOutline}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
